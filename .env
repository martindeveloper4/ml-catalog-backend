# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5500,http://localhost:5500

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=8h

